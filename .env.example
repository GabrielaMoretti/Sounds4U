# Supabase (projeto separado do STRM Insight — ver README)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# O Client ID/Secret do Spotify NÃO entram aqui — ficam configurados dentro do
# Supabase (Authentication → Providers → Spotify). O login é feito via
# supabase.auth.signInWithOAuth({ provider: 'spotify' }).

# Last.fm (gênero musical pro Mapa Musical) — key gratuita em last.fm/api/account/create
VITE_LASTFM_API_KEY=your-lastfm-api-key
